// Atbash Cipher Tool Lite 의 화면. 창 하나에 꼭 필요한 것만:
//   맨 위: 불러오기 · 저장 · 언어 · 다크 모드
//   원본 텍스트 → 변환 방식(+이동 값/지름/키워드/비밀번호) → 변환된 텍스트
//   맨 아래: (복사됨! 안내) [초기화] [복사] [변환]
import { Button, ComboBox, LineEdit, Palette, SpinBox, Switch, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

// 화면에 보이는 글자 (언어가 바뀌면 Rust 가 통째로 바꿔 넣음)
export struct Labels {
    title: string,
    input: string,
    output: string,
    mode: string,
    parameter: string,
    transform: string,
    copy: string,
    clear: string,
    load: string,
    save: string,
    dark: string,
}

export component AppWindow inherits Window {
    in property <Labels> labels;
    in property <[string]> mode-names;
    in property <[string]> language-names;
    // 0: 입력칸 없음, 1: 숫자(이동 값·지름), 2: 키워드, 3: 비밀번호
    in property <int> parameter-kind;
    in property <int> number-minimum: -1000;
    in property <int> number-maximum: 1000;
    in property <string> feedback;
    in property <bool> busy;

    in-out property <int> mode-index;
    in-out property <int> number-value;
    in-out property <string> keyword;
    in-out property <string> password;
    in-out property <string> input-text;
    in-out property <string> output-text;
    in-out property <int> language-index;
    in-out property <bool> dark;

    callback transform();
    callback copy();
    callback clear();
    callback load();
    callback save();
    callback mode-changed(int);
    callback number-changed(int);
    callback language-changed(int);
    callback dark-changed(bool);

    title: root.labels.title;
    icon: @image-url("../../csharp/packaging/linux/atbash-cipher-tool.png");
    preferred-width: 640px;
    preferred-height: 600px;
    min-width: 420px;
    min-height: 440px;

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalBox {
        // 맨 위: 파일과 설정
        HorizontalBox {
            padding: 0;
            Button {
                text: root.labels.load;
                clicked => { root.load(); }
            }
            Button {
                text: root.labels.save;
                clicked => { root.save(); }
            }
            Rectangle { horizontal-stretch: 1; }
            ComboBox {
                model: root.language-names;
                current-index <=> root.language-index;
                selected => { root.language-changed(self.current-index); }
            }
            Switch {
                text: root.labels.dark;
                checked <=> root.dark;
                toggled => { root.dark-changed(self.checked); }
            }
        }

        Text { text: root.labels.input; }
        TextEdit {
            text <=> root.input-text;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        HorizontalBox {
            padding: 0;
            Text {
                text: root.labels.mode;
                vertical-alignment: center;
            }
            ComboBox {
                model: root.mode-names;
                current-index <=> root.mode-index;
                horizontal-stretch: 1;
                selected => { root.mode-changed(self.current-index); }
            }
            if root.parameter-kind != 0: Text {
                text: root.labels.parameter;
                vertical-alignment: center;
            }
            if root.parameter-kind == 1: SpinBox {
                minimum: root.number-minimum;
                maximum: root.number-maximum;
                value <=> root.number-value;
                width: 120px;
                edited(v) => { root.number-changed(v); }
            }
            if root.parameter-kind == 2: LineEdit {
                text <=> root.keyword;
                width: 160px;
            }
            if root.parameter-kind == 3: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                width: 160px;
            }
        }

        Text { text: root.labels.output; }
        TextEdit {
            text <=> root.output-text;
            read-only: true;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        // 맨 아래: 동작 버튼
        HorizontalBox {
            padding: 0;
            Text {
                text: root.feedback;
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: Palette.accent-background;
            }
            Button {
                text: root.labels.clear;
                clicked => { root.clear(); }
            }
            Button {
                text: root.labels.copy;
                clicked => { root.copy(); }
            }
            Button {
                text: root.labels.transform;
                primary: true;
                enabled: !root.busy;
                clicked => { root.transform(); }
            }
        }
    }
}
