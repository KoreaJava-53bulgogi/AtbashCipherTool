<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 기존 Java 버전과 같은 exe 이름: 설치된 바로가기가 그대로 동작하도록 -->
    <AssemblyName>AtbashCipherTool</AssemblyName>
    <RootNamespace>Atbash.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>9.0.0</Version>
    <!-- 파일 속성의 버전에 git 커밋 번호(9.0.0+abc123)가 붙지 않게 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Atbash Cipher Tool</Product>
    <Company>June</Company>
  </PropertyGroup>

  <!--
    배포용 빌드 (release.bat 의 dotnet publish): .NET 포함. 기본은 64비트 Windows.
    다른 운영체제는 -r 로 지정:  dotnet publish -c Release -r osx-arm64 / -r linux-x64
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 미리 컴파일해서 앱이 더 빨리 켜지게 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- 배포본에는 디버그용 파일(.pdb)을 넣지 않음 -->
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en;ko;ja;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    배포본 정리: 라이브러리가 함께 넣는 디버그 파일(약 100MB)과 64비트에서 쓰지 않는 32비트 OCR 엔진.
    Windows 가 아니면 Windows 용 OCR 엔진(x64 폴더의 dll)도 쓸 수 없으므로 뺌.
  -->
  <Target Name="TrimPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdb)" />
    <RemoveDir Directories="$(PublishDir)x86" />
    <RemoveDir Condition="!$(RuntimeIdentifier.StartsWith('win'))" Directories="$(PublishDir)x64" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- 언어 파일: Java 버전과 같은 파일(저장소 맨 위)을 그대로 포함 -->
    <EmbeddedResource Include="..\..\..\ko.json" LogicalName="Atbash.App.Lang.ko.json" Link="Lang\ko.json" />
    <EmbeddedResource Include="..\..\..\en.json" LogicalName="Atbash.App.Lang.en.json" Link="Lang\en.json" />
    <EmbeddedResource Include="..\..\..\ja.json" LogicalName="Atbash.App.Lang.ja.json" Link="Lang\ja.json" />
    <EmbeddedResource Include="..\..\..\zh.json" LogicalName="Atbash.App.Lang.zh.json" Link="Lang\zh.json" />
    <!-- 도움말 → 정보 에 보여주는 README (Java 버전과 같은 파일) -->
    <EmbeddedResource Include="..\..\..\README.txt" LogicalName="Atbash.App.README.txt" Link="README.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- 시작 스플래시 이미지 (Java 버전과 같은 파일) -->
    <AvaloniaResource Include="..\..\..\startup.png" Link="Assets\startup.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR 데이터 (Java 버전과 같은 파일): 실행 파일 옆 tessdata 폴더로 복사 -->
    <None Include="..\..\..\tessdata\*.traineddata" Link="tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atbash.Core\Atbash.Core.csproj" />
  </ItemGroup>
</Project>
