<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 기존 Java 버전과 같은 exe 이름: 설치된 바로가기가 그대로 동작하도록 -->
    <AssemblyName>AtbashCipherTool</AssemblyName>
    <RootNamespace>Atbash.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>9.0.0</Version>
    <Product>Atbash Cipher Tool</Product>
    <Company>June</Company>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>


  <ItemGroup>
    <!-- 언어 파일: Java 버전과 같은 파일(저장소 맨 위)을 그대로 포함 -->
    <EmbeddedResource Include="..\..\..\ko.json" LogicalName="Atbash.App.Lang.ko.json" Link="Lang\ko.json" />
    <EmbeddedResource Include="..\..\..\en.json" LogicalName="Atbash.App.Lang.en.json" Link="Lang\en.json" />
    <EmbeddedResource Include="..\..\..\ja.json" LogicalName="Atbash.App.Lang.ja.json" Link="Lang\ja.json" />
    <EmbeddedResource Include="..\..\..\zh.json" LogicalName="Atbash.App.Lang.zh.json" Link="Lang\zh.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atbash.Core\Atbash.Core.csproj" />
  </ItemGroup>
</Project>
